# Copie para .env. Valores padrão batem com o docker-compose.yml.

NODE_ENV=development
PORT=3000

# Postgres
DATABASE_URL=postgres://listings:listings@localhost:5432/listings

# Redis (BullMQ + projeção do detalhe)
REDIS_URL=redis://localhost:6379

# API de moderação (mock)
MODERATION_API_URL=http://localhost:8787

# JWT (HS256). Gere um segredo forte; nunca reutilize este em outro ambiente.
JWT_SECRET=change-me

# OpenTelemetry → grafana/otel-lgtm
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=listings-api

# Mock: taxa de erro e limite de req/s (só para o docker compose)
MOCK_ERROR_RATE=0.2
MOCK_RATE_LIMIT_RPS=5
