# Copie para .env. Valores padrão batem com o docker-compose.yml.

NODE_ENV=development
PORT=3000

# Postgres
DATABASE_URL=postgres://listings:listings@localhost:5432/listings

# Redis (BullMQ + projeção do detalhe)
REDIS_URL=redis://localhost:6379

# API de moderação (mock)
MODERATION_API_URL=http://localhost:8787
# Moderação: tempo limite por chamada, tentativas por job, espera inicial do backoff
MODERATION_TIMEOUT_MS=3000
MODERATION_ATTEMPTS=5
MODERATION_BACKOFF_MS=1000
# Moderação: limite global de jobs/s e jobs simultâneos por worker
MODERATION_RATE_LIMIT_PER_SECOND=5
MODERATION_CONCURRENCY=5
# Circuit breaker: % de falhas, mínimo de chamadas e tempo aberto
MODERATION_BREAKER_FAILURE_RATE=50
MODERATION_BREAKER_MIN_CALLS=5
MODERATION_BREAKER_OPEN_MS=10000
# Intervalo de polling do relay do outbox (worker)
OUTBOX_POLL_INTERVAL_MS=1000

# JWT (HS256). Gere um segredo forte; nunca reutilize este em outro ambiente.
JWT_SECRET=troque-por-um-segredo-com-32-ou-mais-caracteres

# OpenTelemetry → grafana/otel-lgtm
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=listings-api

# Mock: taxa de erro e limite de req/s (só para o docker compose)
MOCK_ERROR_RATE=0.2
MOCK_RATE_LIMIT_RPS=5
