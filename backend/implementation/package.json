{
  "name": "listings-service",
  "version": "0.1.0",
  "description": "Inserção, listagem e moderação assíncrona de anúncios",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:worker": "nest start --entryFile worker",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "start:prod": "node dist/main.js",
    "start:worker:prod": "node dist/worker.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "test:int": "vitest run --config ./vitest.config.int.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "nest build && node --env-file-if-exists=.env dist/cli/db.js migrate",
    "db:reset": "nest build && node --env-file-if-exists=.env dist/cli/db.js reset",
    "moderation:reprocess": "nest build && node --env-file-if-exists=.env dist/cli/reprocess-moderation.js",
    "auth:token": "nest build && node --env-file-if-exists=.env dist/cli/token.js"
  },
  "dependencies": {
    "@nestjs/bullmq": "^12.0.2",
    "@nestjs/common": "^12.5.0",
    "@nestjs/config": "^12.1.1",
    "@nestjs/core": "^12.5.0",
    "@nestjs/drizzle": "^0.0.2",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/outbox": "^0.1.4",
    "@nestjs/platform-express": "^12.5.0",
    "@nestjs/resilience": "^0.0.3",
    "@nestjs/swagger": "^12.1.2",
    "bullmq": "^6.7.6",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.13",
    "@nestjs/schematics": "^12.0.13",
    "@nestjs/testing": "^12.5.0",
    "@testcontainers/postgresql": "^12.2.1",
    "@testcontainers/redis": "^12.2.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "supertest": "^7.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.12"
  }
}
